EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# local opt-in only; production remains disabled in eas.json
EXPO_PUBLIC_BILLING_ENABLED=false
# public SDK key from RevenueCat; set the actual value only in ignored .env/EAS
# test_ for local Test Store; appl_ for the configured iOS app before store testing
EXPO_PUBLIC_REVENUECAT_API_KEY=
