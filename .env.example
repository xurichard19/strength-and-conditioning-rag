ENVIRONMENT=development
APP_NAME=arcel-api
CORS_ORIGINS=["http://localhost:5173","https://arcelassist.vercel.app"]

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT="arcel"
LANGSMITH_TRACING_SAMPLING_RATE=0.1
LANGSMITH_HIDE_METADATA=true

OPENAI_API_KEY=...
COHERE_API_KEY=...

CHROMA_API_KEY=...
CHROMA_TENANT=...
CHROMA_DATABASE=...

TAVILY_API_KEY=...

SENTRY_DSN=...
SENTRY_TRACES_SAMPLE_RATE=1.0

SUPABASE_URL=...
SUPABASE_PUBLISHABLE_KEY=...
# backend only: secret API key, never a mobile or browser credential
SUPABASE_SECRET_KEY=sb_secret_...

# billing is opt-in; keep disabled until the RevenueCat setup is complete
BILLING_ENABLED=false
# backend-only RevenueCat secret API key; never use an EXPO_PUBLIC_ variable
REVENUECAT_API_KEY=
# exact Authorization header value configured on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTHORIZATION=
# optional: required when HMAC signing is enabled on that webhook
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# RevenueCat app IDs, not bundle IDs; JSON arrays are required
REVENUECAT_APP_IDS=[]
# production only: these Supabase user UUIDs use sandbox/Test Store verification
BILLING_SANDBOX_USER_IDS=[]

DOC_SOURCE=gcs
GCS_BUCKET=your-gcs-bucket
GCS_PREFIX_RAW=raw/system
